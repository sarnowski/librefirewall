# librefirewall hermetic build environment.
#
# The pinned, reproducible builder: every input is version- and checksum-pinned
# (BASE_IMAGE by digest, a dated Debian snapshot plus an exact version for each
# apt package, and sha256-verified downloads for the Microkit SDK, rust-sel4,
# rustup, the Rust channel manifest, GRUB, and syft). This image is a TOOL, not
# the product — the deployable artifact is the signed boot payload xtask builds
# inside it.
#
# Network is available only while building THIS image; the build itself (the
# Makefile `container` recipe) runs --network=none against the warmed offline
# caches. Contract with the Makefile: BASE_IMAGE arrives as a build-arg (from
# sources.lock's DEBIAN_IMAGE) and the corporate TLS-inspection CA arrives as
# the optional build secret `enterprise_ca`. Each RUN that needs it folds it
# together with the system trust store into a bundle on a per-RUN tmpfs
# (/run/build-ca), which is not part of the layer's filesystem: the bundle
# therefore cannot reach an image layer however the block exits, rather than
# depending on a trailing `rm` that a `set -eu` abort — or a later edit past it
# — would skip. The `rm -rf /tmp/*` closing each block is size hygiene for the
# downloaded archives and carries no part of that guarantee.
#
# Apt package versions are pinned inline below rather than in sources.lock:
# a version is only meaningful next to the package name it belongs to, and
# sources.lock pins DEBIAN_SNAPSHOT, the frozen archive they all resolve
# against. Transitive dependencies are not listed individually — the snapshot
# freezes them, so the resolution is deterministic without restating it.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

COPY third-party/sources.lock /tmp/sources.lock

RUN --mount=type=secret,id=enterprise_ca,required=false \
    --mount=type=tmpfs,target=/run/build-ca \
    set -eu; \
    . /tmp/sources.lock; \
    printf '%s\n' \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}/ trixie main" \
      "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}/ trixie-security main" \
      > /etc/apt/sources.list; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    # ca-certificates is not installed yet, so this first apt necessarily runs
    # over plain http and its integrity rests entirely on apt's own Release
    # signatures, verified against the Debian archive keyring baked into the
    # digest-pinned BASE_IMAGE. That keyring is therefore a trust root of this
    # build, on the same footing as the base image digest itself: an attacker
    # who could substitute it could substitute anything in the image. Every
    # later download is https with a pinned sha256 on top.
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get --no-install-recommends install -y \
      ca-certificates=20250419 \
      curl=8.14.1-2+deb13u4; \
    sed -i 's|http://snapshot.debian.org|https://snapshot.debian.org|g' /etc/apt/sources.list; \
    ca_bundle=/etc/ssl/certs/ca-certificates.crt; \
    if [ -s /run/secrets/enterprise_ca ]; then \
      cat "$ca_bundle" /run/secrets/enterprise_ca > /run/build-ca/bundle.crt; \
      ca_bundle=/run/build-ca/bundle.crt; \
    fi; \
    apt-get -o Acquire::https::CaInfo="$ca_bundle" update; \
    # clang is here for libclang, which bindgen dlopens to parse the seL4
    # headers in sel4-sys's build script; without it the protection-domain
    # build fails outright. git is required by `cargo deny check advisories`
    # (the networked CI job), which clones the RustSec database with the git
    # CLI. Neither is used to compile any first-party code.
    DEBIAN_FRONTEND=noninteractive apt-get \
      -o Acquire::https::CaInfo="$ca_bundle" \
      --no-install-recommends install -y \
      binutils=2.44-3 \
      bison=2:3.8.2+dfsg-1+b2 \
      build-essential=12.12 \
      clang=1:19.0-63 \
      dosfstools=4.2-1.2 \
      flex=2.6.4-8.2+b4 \
      gawk=1:5.2.1-2+b1 \
      gdisk=1.0.10-2 \
      git=1:2.47.3-0+deb13u1 \
      gnupg=2.4.7-21+deb13u1 \
      make=4.4.1-2 \
      mtools=4.0.48-1 \
      ovmf=2025.02-8+deb13u1 \
      pkg-config=1.8.1-4 \
      python3=3.13.5-1 \
      qemu-system-x86=1:10.0.11+ds-0+deb13u1 \
      xz-utils=5.8.1-1+deb13u1; \
    curl --fail --location --proto '=https' --tlsv1.2 --cacert "$ca_bundle" \
      --output /tmp/microkit-sdk.tar.gz "$MICROKIT_URL"; \
    printf '%s  %s\n' "$MICROKIT_SHA256" /tmp/microkit-sdk.tar.gz | sha256sum --check --strict -; \
    mkdir -p "/opt/microkit-sdk-${MICROKIT_VERSION}"; \
    tar --extract --gzip --file /tmp/microkit-sdk.tar.gz \
      --strip-components=1 --directory "/opt/microkit-sdk-${MICROKIT_VERSION}"; \
    ln -s "/opt/microkit-sdk-${MICROKIT_VERSION}" /opt/microkit; \
    # Write the VERSION file xtask's verify_inputs reads from the pinned value,
    # rather than relying on the tarball happening to ship it; this makes the
    # SDK/version contract explicit and independent of upstream packaging.
    printf '%s\n' "$MICROKIT_VERSION" > /opt/microkit/VERSION; \
    curl --fail --location --proto '=https' --tlsv1.2 --cacert "$ca_bundle" \
      --output /tmp/rust-sel4.tar.gz "$RUST_SEL4_URL"; \
    printf '%s  %s\n' "$RUST_SEL4_SHA256" /tmp/rust-sel4.tar.gz | sha256sum --check --strict -; \
    mkdir -p /opt/rust-sel4; \
    tar --extract --gzip --file /tmp/rust-sel4.tar.gz \
      --strip-components=1 --directory /opt/rust-sel4; \
    # Same explicit contract; the source tag carries a leading `v` that the
    # on-disk VERSION and xtask's comparison do not, so strip it.
    printf '%s\n' "${RUST_SEL4_VERSION#v}" > /opt/rust-sel4/VERSION; \
    curl --fail --location --proto '=https' --tlsv1.2 --cacert "$ca_bundle" \
      --output /tmp/rustup-init "$RUSTUP_INIT_URL"; \
    printf '%s  %s\n' "$RUSTUP_INIT_SHA256" /tmp/rustup-init | sha256sum --check --strict -; \
    chmod 0755 /tmp/rustup-init; \
    # The toolchain archives rustup fetches are hash-verified by rustup against
    # the channel manifest, so pinning that one manifest pins the whole
    # toolchain. Verify it here so a silently republished nightly — the real
    # reproducibility risk for a dated channel — fails the build loudly.
    # A mismatched pin would make the check vacuous (we would verify one date's
    # manifest while rustup installed another), so the two are cross-checked
    # before either is used.
    manifest_date="${RUST_TOOLCHAIN#nightly-}"; \
    case "$RUST_CHANNEL_MANIFEST_URL" in \
      *"/dist/${manifest_date}/"*) ;; \
      *) echo "sources.lock: RUST_CHANNEL_MANIFEST_URL is not the manifest for ${RUST_TOOLCHAIN}" >&2; exit 1;; \
    esac; \
    curl --fail --location --proto '=https' --tlsv1.2 --cacert "$ca_bundle" \
      --output /tmp/channel-rust-nightly.toml "$RUST_CHANNEL_MANIFEST_URL"; \
    printf '%s  %s\n' "$RUST_CHANNEL_MANIFEST_SHA256" /tmp/channel-rust-nightly.toml \
      | sha256sum --check --strict -; \
    SSL_CERT_FILE="$ca_bundle" RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/opt/rust/cargo \
      /tmp/rustup-init -y --no-modify-path --profile minimal \
      --default-toolchain "$RUST_TOOLCHAIN" \
      --component rust-src --component rustfmt --component clippy --component llvm-tools-preview; \
    curl --fail --location --proto '=https' --tlsv1.2 --cacert "$ca_bundle" \
      --output /tmp/grub.tar.xz "$GRUB_URL"; \
    printf '%s  %s\n' "$GRUB_SHA256" /tmp/grub.tar.xz | sha256sum --check --strict -; \
    mkdir -p /tmp/grub-src; \
    tar --extract --xz --file /tmp/grub.tar.xz --strip-components=1 --directory /tmp/grub-src; \
    cd /tmp/grub-src; \
    ./configure --target=x86_64 --with-platform=efi --prefix=/opt/grub \
      --disable-nls --disable-werror --disable-grub-mkfont --disable-grub-themes; \
    make -j"$(nproc)"; \
    make install; \
    cd /; \
    "/opt/grub/bin/grub-mkstandalone" --version | grep --fixed-strings "$GRUB_VERSION"; \
    rm -rf /var/lib/apt/lists/* /tmp/*

COPY third-party/sources.lock /tmp/syft-sources.lock

RUN --mount=type=secret,id=enterprise_ca,required=false \
    --mount=type=tmpfs,target=/run/build-ca \
    set -eu; \
    . /tmp/syft-sources.lock; \
    ca_bundle=/etc/ssl/certs/ca-certificates.crt; \
    if [ -s /run/secrets/enterprise_ca ]; then \
      cat "$ca_bundle" /run/secrets/enterprise_ca > /run/build-ca/bundle.crt; \
      ca_bundle=/run/build-ca/bundle.crt; \
    fi; \
    curl --fail --location --proto '=https' --tlsv1.2 --cacert "$ca_bundle" \
      --output /tmp/syft.tar.gz "$SYFT_URL"; \
    printf '%s  %s\n' "$SYFT_SHA256" /tmp/syft.tar.gz | sha256sum --check --strict -; \
    tar --extract --gzip --file /tmp/syft.tar.gz --directory /usr/local/bin syft; \
    syft version | grep --fixed-strings "$SYFT_VERSION"; \
    rm -rf /tmp/*

ENV PATH=/opt/grub/bin:/opt/rust/cargo/bin:$PATH \
    RUSTUP_HOME=/opt/rust/rustup \
    CARGO_HOME=/opt/rust/cargo \
    SYFT_CHECK_FOR_APP_UPDATE=false

# The build runs as the keep-id host user, not root; make the SDK world-readable
# so that user can read the board files and the microkit tool.
RUN chmod -R a+rX /opt/microkit/

# Pinned Rust developer tools baked into the image so the offline host gate can
# run them: coverage (cargo-llvm-cov), dependency/license policy (cargo-deny),
# and fuzzing (cargo-fuzz, used in a later phase). This is the network phase;
# --locked builds each tool from its published lockfile for reproducibility.
COPY third-party/sources.lock /tmp/tools-sources.lock
RUN --mount=type=secret,id=enterprise_ca,required=false \
    --mount=type=tmpfs,target=/run/build-ca \
    set -eu; \
    . /tmp/tools-sources.lock; \
    ca_bundle=/etc/ssl/certs/ca-certificates.crt; \
    if [ -s /run/secrets/enterprise_ca ]; then \
      cat "$ca_bundle" /run/secrets/enterprise_ca > /run/build-ca/bundle.crt; \
      ca_bundle=/run/build-ca/bundle.crt; \
    fi; \
    SSL_CERT_FILE="$ca_bundle" \
      cargo install --locked --version "$CARGO_LLVM_COV_VERSION" cargo-llvm-cov; \
    SSL_CERT_FILE="$ca_bundle" \
      cargo install --locked --version "$CARGO_DENY_VERSION" cargo-deny; \
    SSL_CERT_FILE="$ca_bundle" \
      cargo install --locked --version "$CARGO_FUZZ_VERSION" cargo-fuzz; \
    rm -rf /tmp/*

# Warm the offline dependency cache from the manifests alone. `cargo fetch`
# needs every workspace member's Cargo.toml and the lockfile, but not the real
# sources — empty target stubs (synthesized in the RUN below) are enough to load
# each manifest. The build context is restricted to exactly those manifests by
# build/container/containerignore, so this single `COPY .` needs no list of
# workspace members to keep in step, and the layer is invalidated only when a
# manifest or lockfile actually changes.
COPY . /tmp/workspace/

RUN --mount=type=secret,id=enterprise_ca,required=false \
    --mount=type=tmpfs,target=/run/build-ca \
    set -eu; \
    ca_bundle=/etc/ssl/certs/ca-certificates.crt; \
    if [ -s /run/secrets/enterprise_ca ]; then \
      cat "$ca_bundle" /run/secrets/enterprise_ca > /run/build-ca/bundle.crt; \
      ca_bundle=/run/build-ca/bundle.crt; \
    fi; \
    cd /tmp/workspace; \
    # Materialize the manifest list first: inside `$(...)` a failing find would
    # be swallowed into an empty word list and silently skip every stub, so the
    # build would only fall over later with a confusing cargo error.
    find . -name Cargo.toml -type f > /tmp/manifests.list; \
    while IFS= read -r manifest; do \
      stub="$(dirname "$manifest")/src"; \
      mkdir -p "$stub"; \
      : > "$stub/lib.rs"; \
      : > "$stub/main.rs"; \
    done < /tmp/manifests.list; \
    # Bench and fuzz-target files, so target validation during fetch sees them:
    # a manifest declaring `[[bench]]` or `[[bin]]` is held to the file, and the
    # sources themselves are excluded from this context by containerignore.
    #
    # DERIVED FROM THE MANIFESTS, never listed. Three hand-written lists lived
    # here and every one of them went stale the moment a crate gained a bench —
    # invisibly, because this layer is cached until a manifest changes, so the
    # failure surfaced on some later, unrelated edit as `can't find <name> bench`
    # in a crate that edit never touched. Reading the declarations is what makes
    # a new bench or fuzz target need no edit here, which is the same property
    # containerignore's wildcards give the `COPY` above.
    while IFS= read -r manifest; do \
      dir="$(dirname "$manifest")"; \
      awk '/^\[\[bench\]\]/{inb=1;next} /^\[/{inb=0} inb && $1=="name"{gsub(/"/,"",$3); print $3}' "$manifest" \
      | while IFS= read -r bench; do \
          mkdir -p "$dir/benches"; \
          : > "$dir/benches/$bench.rs"; \
        done; \
    done < /tmp/manifests.list; \
    awk '/^\[\[bin\]\]/{inb=1;next} /^\[/{inb=0} inb && $1=="path"{gsub(/"/,"",$3); print $3}' fuzz/Cargo.toml \
    | while IFS= read -r target; do \
        mkdir -p "fuzz/$(dirname "$target")"; \
        : > "fuzz/$target"; \
      done; \
    SSL_CERT_FILE="$ca_bundle" cargo fetch --locked; \
    SSL_CERT_FILE="$ca_bundle" cargo fetch --locked --manifest-path fuzz/Cargo.toml; \
    sysroot="$(rustc --print sysroot)/lib/rustlib/src/rust/library/sysroot/Cargo.toml"; \
    SSL_CERT_FILE="$ca_bundle" cargo fetch --locked --manifest-path "$sysroot"; \
    chmod -R a+rX /opt/rust/cargo/registry; \
    rm -rf /tmp/*

WORKDIR /workspace
