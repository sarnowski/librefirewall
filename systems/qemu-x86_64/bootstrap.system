<?xml version="1.0" encoding="UTF-8"?>
<system>
    <!-- Zero-copy dataplane region shared by both PDs: two SPSC rings and a
         buffer pool (see crates/pd-runtime). 0x40000 matches pd_runtime::REGION_SIZE,
         which the build asserts is large enough for the Shared layout. -->
    <memory_region name="dataplane" size="0x40000" />

    <protection_domain name="responder" priority="2" stack_size="0x4000">
        <program_image path="bootstrap-responder.elf" />
        <map mr="dataplane" vaddr="0x2_000_000" perms="rw" setvar_vaddr="dataplane_vaddr" />
    </protection_domain>

    <protection_domain name="initiator" priority="1" stack_size="0x4000">
        <program_image path="bootstrap-initiator.elf" />
        <map mr="dataplane" vaddr="0x2_000_000" perms="rw" setvar_vaddr="dataplane_vaddr" />
    </protection_domain>

    <channel>
        <end pd="initiator" id="0" />
        <end pd="responder" id="0" />
    </channel>
</system>
